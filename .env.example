# 复制成 .env 后填写：cp .env.example .env
# .env 已经写在 .gitignore 里，不会被提交。

# ---- 必填 ----
# API Key，在 https://console.anthropic.com/ 获取
ANTHROPIC_API_KEY=sk-ant-xxx
# 模型 ID，默认是 Claude Opus 5.5
MODEL_ID=claude-opus-5-5

# ---- 可选：Anthropic 兼容服务 ----
# 设置了 ANTHROPIC_BASE_URL（并且不是 api.anthropic.com），loopback 就认为这是兼容服务，
# 会默认关掉 Claude 专属的能力：缓存参数、effort、fallback、web_search、读图。
# 某项能力对方也支持的话，可以单独打开：LOOPBACK_VISION=1 / LOOPBACK_SERVER_TOOLS=1
#
# DeepSeek（2026-10 核对：deepseek-flash 能读图；deepseek-v4-pro 能力更强，但不能读图；上下文都是 1M）
# 注意：MODEL_ID 必须改成 DeepSeek 的模型名。如果忘了改，claude-opus-* 会被静默映射成 deepseek-v4-pro
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-flash
# LOOPBACK_VISION=1        # 只有 deepseek-flash 才开
# 下面几个服务商的模型名可能已经更新，以各家官方文档为准
# Kimi（国内）
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MODEL_ID=kimi-k2.5
# GLM（国内）
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# MODEL_ID=glm-5
# MiniMax（国内）
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# MODEL_ID=MiniMax-M2.5

# ---- 可选：运行参数 ----
# 个人状态目录，默认 ./workspace（不进 git）。想备份可以指向一个私有仓库或网盘目录
# LOOPBACK_HOME=./workspace
# 推理深度：low / medium / high / xhigh / max。只在官方接口上生效
# LOOPBACK_EFFORT=high
# 日志级别，日志写在 $LOOPBACK_HOME/logs/loopback.log
# LOOPBACK_LOG_LEVEL=INFO
